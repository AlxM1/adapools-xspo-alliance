# ============================================================
# Newsletter Video Pipeline - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# ============================================================

# General Settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================================
# GPU SERVER (Windows 11 with RTX 5090)
# ============================================================
# The IP address of your Windows machine with the GPU
GPU_HOST=192.168.1.100
GPU_VOICE_PORT=5002
GPU_AVATAR_PORT=5003
GPU_TIMEOUT=300
GPU_MAX_RETRIES=3

# ============================================================
# VOICE CLONER (XTTS-v2)
# ============================================================
VOICE_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
VOICE_DEFAULT_LANGUAGE=en
VOICE_SAMPLE_RATE=24000
VOICE_USE_DEEPSPEED=true
VOICE_USE_STREAMING=true

# ============================================================
# AVATAR GENERATOR (MuseTalk + LivePortrait)
# ============================================================
AVATAR_OUTPUT_RESOLUTION=1080p
AVATAR_FPS=30
AVATAR_USE_FACE_ENHANCEMENT=true
AVATAR_USE_BACKGROUND_REMOVAL=false

# ============================================================
# VIDEO PROCESSOR
# ============================================================
VIDEO_FFMPEG_PATH=ffmpeg

# YouTube settings
VIDEO_YOUTUBE_RESOLUTION=1920x1080
VIDEO_YOUTUBE_FPS=30
VIDEO_YOUTUBE_BITRATE=8M

# TikTok settings
VIDEO_TIKTOK_RESOLUTION=1080x1920
VIDEO_TIKTOK_FPS=30
VIDEO_TIKTOK_MAX_DURATION=600

# Instagram settings
VIDEO_INSTAGRAM_RESOLUTION=1080x1920
VIDEO_INSTAGRAM_MAX_DURATION=90

# X/Twitter settings
VIDEO_X_RESOLUTION=1920x1080
VIDEO_X_MAX_DURATION=140

# Shorts settings
VIDEO_SHORTS_RESOLUTION=1080x1920
VIDEO_SHORTS_MAX_DURATION=60

# ============================================================
# SOCIAL PUBLISHER - YouTube
# ============================================================
SOCIAL_YOUTUBE_DEFAULT_PRIVACY=private
SOCIAL_YOUTUBE_DEFAULT_CATEGORY=22

# ============================================================
# SOCIAL PUBLISHER - TikTok
# ============================================================
# Get these from https://developers.tiktok.com/
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_TIKTOK_REDIRECT_URI=http://localhost:8080/tiktok/callback

# ============================================================
# SOCIAL PUBLISHER - Instagram
# ============================================================
# Use a business account for API access
SOCIAL_INSTAGRAM_USERNAME=
SOCIAL_INSTAGRAM_PASSWORD=
SOCIAL_INSTAGRAM_2FA_SEED=

# ============================================================
# SOCIAL PUBLISHER - X/Twitter
# ============================================================
# Get these from https://developer.twitter.com/
SOCIAL_X_API_KEY=
SOCIAL_X_API_SECRET=
SOCIAL_X_ACCESS_TOKEN=
SOCIAL_X_ACCESS_TOKEN_SECRET=
SOCIAL_X_BEARER_TOKEN=

# ============================================================
# SCRIPT GENERATOR (LLM)
# ============================================================
# Options: local (Ollama), openai, anthropic
SCRIPT_LLM_PROVIDER=local
SCRIPT_LLM_MODEL=qwen2.5:7b
SCRIPT_LLM_BASE_URL=http://localhost:11434

# For OpenAI (optional)
SCRIPT_OPENAI_API_KEY=

# For Anthropic (optional)
SCRIPT_ANTHROPIC_API_KEY=

# ============================================================
# REDIS (Job Queue)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================
# API GATEWAY
# ============================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_KEY=your-secure-api-key-here
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_PERIOD=60

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================
POSTGRES_USER=nvp
POSTGRES_PASSWORD=nvp_password_change_in_production
POSTGRES_DB=newsletter_video_pipeline
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql+asyncpg://nvp:nvp_password_change_in_production@postgres:5432/newsletter_video_pipeline

# ============================================================
# AUTHENTICATION
# ============================================================
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# MONITORING (Grafana)
# ============================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_change_in_production

# ============================================================
# BACKUP
# ============================================================
BACKUP_DIR=/opt/nvp/backups
RETENTION_DAYS=7

# ============================================================
# FRONTEND
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
